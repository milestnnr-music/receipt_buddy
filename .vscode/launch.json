{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Hermes (Expo)",
      "type": "expo",
      "request": "attach",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "webpack:///": "${workspaceFolder}/",
        "expo-development-client://*": "${workspaceFolder}/*"
      }
    }
  ]
}